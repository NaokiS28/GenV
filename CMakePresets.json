{
	"version": 10,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 29,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base-debug",
			"hidden": true,
			"description": "No optimisation, assertions enabled.",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "base-release",
			"hidden": true,
			"description": "Performance optimisation, assertions stripped.",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "base-minsizerel",
			"hidden": true,
			"description": "Size optimisation, assertions stripped.",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
		},
		{
			"name": "base-common",
			"hidden": true,
			"generator": "Ninja",
			"graphviz": "graph/build_graph.dot"
		},
		{
			"name": "base-win-x64",
			"hidden": true,
			"inherits": "base-common",
			"binaryDir": "${sourceDir}/build/win/x64",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/win32/toolchain.cmake",
				"GENV_PLATFORM": "win32",
				"GENV_ARCH": "x64"
			}
		},
		{
			"name": "base-win-x86",
			"hidden": true,
			"inherits": "base-common",
			"binaryDir": "${sourceDir}/build/win/x86",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/win32/toolchain.cmake",
				"GENV_PLATFORM": "win32",
				"GENV_ARCH": "x86"
			}
		},
		{
			"name": "base-psx",
			"hidden": true,
			"inherits": "base-common",
			"binaryDir": "${sourceDir}/build/psx/psx",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/psx/toolchain.cmake",
				"GENV_PLATFORM": "psx",
				"GENV_SUBPLATFORM": "psx"
			}
		},
		{
			"name": "base-sys573",
			"hidden": true,
			"inherits": "base-common",
			"binaryDir": "${sourceDir}/build/psx/sys573",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/psx/toolchain.cmake",
				"GENV_PLATFORM": "psx",
				"GENV_SUBPLATFORM": "sys573"
			}
		},
		{
			"name": "base-gv999",
			"hidden": true,
			"inherits": "base-common",
			"binaryDir": "${sourceDir}/build/psx/gv999",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/psx/toolchain.cmake",
				"GENV_PLATFORM": "psx",
				"GENV_SUBPLATFORM": "gv999"
			}
		},
		{
			"name": "base-macos-universal",
			"hidden": true,
			"inherits": "base-common",
			"binaryDir": "${sourceDir}/build/mac/osx",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/mac/osx-toolchain.cmake",
				"GENV_PLATFORM": "mac",
				"GENV_SUBPLATFORM": "osx",
				"GENV_ARCH": "universal",
				"CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
				"CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
			}
		},
		{
			"name": "win-x64-debug",
			"displayName": "Win64 Debug",
			"inherits": [ "base-win-x64", "base-debug" ]
		},
		{
			"name": "win-x64-release",
			"displayName": "Win64 Release",
			"inherits": [ "base-win-x64", "base-release" ]
		},
		{
			"name": "win-x64-minsizerel",
			"displayName": "Win64 MinSizeRel",
			"inherits": [ "base-win-x64", "base-minsizerel" ]
		},
		{
			"name": "win-x86-debug",
			"displayName": "Win32 Debug",
			"inherits": [ "base-win-x86", "base-debug" ]
		},
		{
			"name": "win-x86-release",
			"displayName": "Win32 Release",
			"inherits": [ "base-win-x86", "base-release" ]
		},
		{
			"name": "win-x86-minsizerel",
			"displayName": "Win32 MinSizeRel",
			"inherits": [ "base-win-x86", "base-minsizerel" ]
		},
		{
			"name": "macos-universal-debug",
			"displayName": "macOS Universal Debug",
			"inherits": [ "base-macos-universal", "base-debug" ],
			"description": "This build is only available on macOS",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "macos-universal-release",
			"displayName": "macOS Universal Release",
			"inherits": [ "base-macos-universal", "base-release" ],
			"description": "This build is only available on macOS",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "macos-universal-minsizerel",
			"displayName": "macOS Universal MinSizeRel",
			"inherits": [ "base-macos-universal", "base-minsizerel" ],
			"description": "This build is only available on macOS",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "psx-debug",
			"displayName": "PSX Debug",
			"inherits": [ "base-psx", "base-debug" ]
		},
		{
			"name": "psx-release",
			"displayName": "PSX Release",
			"inherits": [ "base-psx", "base-release" ]
		},
		{
			"name": "psx-minsizerel",
			"displayName": "PSX MinSizeRel",
			"inherits": [ "base-psx", "base-minsizerel" ]
		},
		{
			"name": "sys573-debug",
			"displayName": "System 573 Debug",
			"inherits": [ "base-sys573", "base-debug" ]
		},
		{
			"name": "sys573-release",
			"displayName": "System 573 Release",
			"inherits": [ "base-sys573", "base-release" ]
		},
		{
			"name": "sys573-minsizerel",
			"displayName": "System 573 MinSizeRel",
			"inherits": [ "base-sys573", "base-minsizerel" ]
		},
		{
			"name": "gv999-debug",
			"displayName": "GV999 Debug",
			"inherits": [ "base-gv999", "base-debug" ]
		},
		{
			"name": "gv999-release",
			"displayName": "GV999 Release",
			"inherits": [ "base-gv999", "base-release" ]
		},
		{
			"name": "gv999-minsizerel",
			"displayName": "GV999 MinSizeRel",
			"inherits": [ "base-gv999", "base-minsizerel" ]
		}
	]
}
