# clangd configuration for GenV multi-platform project.
#
# Rule evaluation: clangd applies ALL matching fragments (they merge/override
# top-to-bottom). The fragments below are ordered from most-specific to least.
#
# compile_commands.json locations:
#   build/compile_commands.json        — root, updated by cmake on every configure
#   build/mac/osx/compile_commands.json — macOS build
#   build/psx/psx/compile_commands.json — PSX build (used as shared-source fallback)

---
# PSX hardware source — use the PSX compile_commands
If:
  PathMatch: [ src/genv_hw/psx/.* ]
CompileFlags:
  Add:    [ --target=mipsel-none-elf, -march=mips1 ]
  Remove: [ -march, -mno-llsc, -mdivide-breaks, -std ]
  CompilationDatabase: build/psx/psx

---
# PSX build output (generated files under build/psx)
If:
  PathMatch: [ build/psx/.* ]
CompileFlags:
  Add:    [ --target=mipsel-none-elf, -march=mips1 ]
  Remove: [ -march, -mno-llsc, -mdivide-breaks, -std ]
  CompilationDatabase: build/psx/psx

---
# macOS hardware source and build output
If:
  PathMatch: [ src/genv_hw/mac/.*, build/mac/.* ]
CompileFlags:
  Remove: [ -arch ]
  Add:    [ --target=arm64-apple-macos11, -isysroot/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk ]
  CompilationDatabase: build/mac/osx

---
# Shared source (genv_common, main, example, etc.) — use the root db which
# cmake updates to the most recently configured platform on every configure run.
# On a Mac host this will normally be the mac build; on a CI/PSX host, the PSX
# build. Either way the include paths for shared source are identical.
CompileFlags:
  Remove: [ -arch, -march, -mno-llsc, -mdivide-breaks ]
  CompilationDatabase: build

Diagnostics:
  UnusedIncludes: None
