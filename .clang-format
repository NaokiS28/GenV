# GenV clang-format — mimic VS Code + MS C/C++ (VC Format)

BasedOnStyle: Microsoft
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Put everything inside namespaces one indent in (VC Format-like)
NamespaceIndentation: All

AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false

# Brace & spacing style (Visual Studio-ish)
BreakBeforeBraces: Allman
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false

# Pointers/refs style: type-adjacent (int* p, const T& r)
DerivePointerAlignment: false
PointerAlignment: Right
ReferenceAlignment: Right

# Switch/case & access specifiers
IndentCaseLabels: false
AccessModifierOffset: -4

# Includes: don’t reorder or group (avoid churn vs VC)
SortIncludes: false
IncludeBlocks: Preserve

# Line wrapping/comments
ColumnLimit: 0
ReflowComments: IndentOnly
AlignTrailingComments:
    Kind: Always
    OverEmptyLines: 0


# Keep tiny functions on one line only if truly empty
AllowShortCaseLabelsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse

# Preprocessor at column 0 (nice for bare-metal work)
IndentPPDirectives: None
