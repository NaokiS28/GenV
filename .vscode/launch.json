{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "gdb",
			"request": "attach",
			"name": "GenV (PSX-gdb)",
			"target": "localhost:3333",
			"remote": true,
			"stopAtConnect": true,
			"executable": "./bin/debug/psx/psx/GenV-debug.elf",
			"gdbpath": "/opt/homebrew/bin/gdb",
			"preLaunchTask": "CMake: build",
			"windows": {
				"gdbpath": "gdb-multiarch.exe",
			},
			"cwd": "${workspaceRoot}",
			"autorun": [
				"set substitute-path /project .",
				"monitor reset shellhalt",
				"load ./bin/debug/psx/psx/GenV-debug.elf",
				"tbreak main",
				"continue",
			],
			"valuesFormatting": "parseText"
		},
		{
			"type": "gdb",
			"request": "attach",
			"name": "GenV (573-gdb)",
			"target": "localhost:3333",
			"remote": true,
			"stopAtConnect": true,
			"executable": "./bin/debug/psx/sys573/GenV-debug.elf",
			"gdbpath": "/opt/homebrew/bin/gdb",
			"preLaunchTask": "CMake: build",
			"windows": {
				"gdbpath": "gdb-multiarch.exe",
			},
			"cwd": "${workspaceRoot}",
			"autorun": [
				"set substitute-path /project .",
				"monitor reset shellhalt",
				"load ./bin/debug/psx/sys573/GenV-debug.elf",
				"tbreak main",
				"continue",
			],
			"valuesFormatting": "parseText"
		},
		{
			"name": "PyTerm (PSX)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/scripts/pyterm.py",
			"args": [
				"-url",
				"localhost",
				"-port",
				"6699"
			],
			"console": "integratedTerminal"
		},
		{
			"name": "Debug (cmake)",
			"type": "node",
			"request": "launch",
			"program": "${command:cmake.launchTargetPath}",
			"args": [],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Python Debugger: Current File with Arguments",
			"type": "debugpy",
			"request": "launch",
			"program": "${file}",
			"console": "integratedTerminal",
			"justMyCode": true,
			"args": [
				"-o spice.gvf",
				"/Volumes/Nextcloud/Programming/Project-Vigfell/lib/GenV/assets/fonts/spice/spice.json"
			],
			"purpose": [
				"debug-in-terminal"
			]
		}
	],
	"compounds": [
		{
			"name": "GenV-PSX + PyTerm",
			"configurations": [
				"GenV (PSX-gdb)",
				"PyTerm (PSX)"
			],
			"presentation": {
				"hidden": false,
				"group": "PSX",
				"order": 1
			},
			"preLaunchTask": "CMake: build",
			"stopAll": true
		},
		{
			"name": "GenV-573 + PyTerm",
			"configurations": [
				"GenV (573-gdb)",
				"PyTerm (PSX)"
			],
			"presentation": {
				"hidden": false,
				"group": "PSX",
				"order": 1
			},
			"preLaunchTask": "CMake: build",
			"stopAll": true
		}
	]
}